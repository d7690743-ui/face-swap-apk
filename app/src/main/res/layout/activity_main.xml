<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Face Swap"
            android:textSize="22sp" />

        <ImageView
            android:id="@+id/source_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:background="#22000000"
            android:contentDescription="Foto fuente"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/pick_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elegir foto fuente" />

        <ImageView
            android:id="@+id/target_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:background="#22000000"
            android:contentDescription="Foto destino"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/pick_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elegir foto destino" />

        <Button
            android:id="@+id/swap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Swap" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Elige foto fuente y foto destino." />

    </LinearLayout>
</ScrollView>
